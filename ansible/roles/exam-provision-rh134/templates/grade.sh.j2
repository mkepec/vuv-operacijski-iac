#!/bin/bash
# Student grading script — RH134 mid-semester exam
# Variant: {{ exam_variant }}  Host: {{ inventory_hostname }}
# Generated by Ansible at provisioning time. Do not edit.

VARIANT="{{ exam_variant }}"
HOSTNAME="{{ inventory_hostname }}"
SCRIPT_NAME="{{ rh134_script_name }}"
REPORT_FILE="{{ rh134_report_file }}"
VG_NAME="{{ rh134_vg_name }}"
LV_NAME="{{ rh134_lv_name }}"
LV_INITIAL_SIZE="{{ rh134_lv_initial_size }}"
LV_EXTEND_SIZE="{{ rh134_lv_extend_size }}"
MOUNT_POINT="{{ rh134_mount_point }}"
RSYSLOG_FACILITY="{{ rh134_rsyslog_facility }}"
RSYSLOG_PRIORITY="{{ rh134_rsyslog_priority }}"
LOG_FILE="{{ rh134_log_file }}"
NFS_EXPORT_DIR="{{ rh134_nfs_export_dir }}"
NFS_LOCAL_MOUNT="{{ rh134_nfs_local_mount }}"
PODMAN_PORT="{{ rh134_podman_port }}"
PODMAN_IMAGE_TEXT="{{ rh134_podman_image_text }}"
BACKUP_DIR="{{ rh134_backup_dir }}"
BASE_IMAGE="{{ rh134_base_image }}"

PASS=0
FAIL=1

pass() { echo "  [PASS] $1"; }
fail() { echo "  [FAIL] $1"; }

# Shared reboot-detection helper — true if the system has booted since
# /var/exam-provision-time was written (mtime-based, content not used)
rebooted_since_provision() {
    [ -f /var/exam-provision-time ] || return 1
    local provision_ts boot_ts
    provision_ts=$(stat -c %Y /var/exam-provision-time)
    boot_ts=$(date -d "$(who -b | awk '{print $3, $4}')" +%s 2>/dev/null)
    [ -n "$boot_ts" ] && [ "$boot_ts" -gt "$provision_ts" ]
}

run_task() {
    local task="$1"
    case "$task" in
        t1) grade_t1 ;;
        t2) grade_t2 ;;
        t3) grade_t3 ;;
        t4) grade_t4 ;;
        t5) grade_t5 ;;
        t6) grade_t6 ;;
        *) echo "Unknown task: $task"; exit 1 ;;
    esac
}

grade_t1() {
    local score=0 max=15
    echo ""
    echo "Task 1 — Shell Scripting: Service Status Report"

    local script="/home/student/bin/${SCRIPT_NAME}"

    if [ -x "$script" ]; then
        pass "Script ${script} exists and is executable"; ((score+=3))
    else
        fail "Script ${script} missing or not executable"
    fi

    local refs_ok=true
    for svc in sshd crond chronyd rsyslog; do
        grep -q "$svc" "$script" 2>/dev/null || refs_ok=false
    done
    if $refs_ok; then
        pass "Script references all 4 service names"; ((score+=4))
    else
        fail "Script does not reference all 4 required service names (sshd crond chronyd rsyslog)"
    fi

    local out format_ok=true
    out=$(bash "$script" 2>/dev/null)
    local line_count
    line_count=$(echo "$out" | grep -c .)
    if [ "${line_count:-0}" -eq 4 ]; then
        while IFS= read -r line; do
            [[ "$line" =~ ^SERVICE:\ [a-zA-Z0-9_.-]+\ ACTIVE:\ (active|inactive)\ ENABLED:\ (enabled|disabled)$ ]] || format_ok=false
        done <<< "$out"
    else
        format_ok=false
    fi
    if $format_ok; then
        local fields_ok=true
        for svc in sshd crond chronyd rsyslog; do
            local live_active live_enabled line_active line_enabled
            live_active=$(systemctl is-active "$svc" 2>/dev/null)
            live_enabled=$(systemctl is-enabled "$svc" 2>/dev/null)
            line_active=$(echo "$out" | grep "SERVICE: ${svc} " | sed -n 's/.*ACTIVE: \([a-z]*\).*/\1/p')
            line_enabled=$(echo "$out" | grep "SERVICE: ${svc} " | sed -n 's/.*ENABLED: \([a-z]*\).*/\1/p')
            [ "$live_active" = "$line_active" ] && [ "$live_enabled" = "$line_enabled" ] || fields_ok=false
        done
        if $fields_ok; then
            pass "Script produces 4 correctly-formatted lines matching live state"; ((score+=5))
        else
            fail "Output format is correct but ACTIVE/ENABLED fields don't match live systemctl state"
        fi
    else
        fail "Output is not 4 lines in the exact required format"
    fi

    bash "$script" &>/dev/null
    bash "$script" &>/dev/null
    local rerun_count
    rerun_count=$(grep -c . "$REPORT_FILE" 2>/dev/null)
    if [ "${rerun_count:-0}" -eq 4 ]; then
        pass "Output file is overwritten on rerun (4 lines, not duplicated)"; ((score+=3))
    else
        fail "Output file ${REPORT_FILE} has ${rerun_count:-0} lines after two runs — expected 4 (overwrite, not append)"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t2() {
    local score=0 max=20
    echo ""
    echo "Task 2 — LVM: Build, Mount, and Extend Storage"

    # NOTE: the dedicated raw disk's kernel-assigned letter (/dev/sda vs /dev/sdb)
    # is NOT stable across reboots — both it and the OS disk sit on the SCSI bus,
    # and the kernel names them in async-probe completion order, which can vary
    # boot to boot (confirmed live: they swapped after a single reboot on this
    # very host). The only stable distinguishing fact is that the dedicated disk
    # is whichever SCSI-bus disk does NOT back the root filesystem — so derive
    # the root disk and check the PV sits on the *other* one.
    local root_disk pv_disk
    root_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -1)
    pv_disk=$(sudo pvs --noheadings -o pv_name,vg_name 2>/dev/null | awk -v vg="$VG_NAME" '$2 == vg {print $1}' | sed -E 's#/dev/(sd[a-z]).*#\1#')
    if sudo vgs "$VG_NAME" &>/dev/null && [ -n "$pv_disk" ] && [[ "$pv_disk" == sd* ]] && [ "$pv_disk" != "$root_disk" ]; then
        pass "Volume group ${VG_NAME} exists on a PV from the dedicated raw disk (/dev/${pv_disk}, not the OS disk /dev/${root_disk})"; ((score+=4))
    else
        fail "Volume group ${VG_NAME} missing, or its PV is not on the dedicated raw SCSI disk (found: ${pv_disk:-none}, OS disk: /dev/${root_disk:-?})"
    fi

    local fstype
    fstype=$(sudo blkid -o value -s TYPE "/dev/${VG_NAME}/${LV_NAME}" 2>/dev/null)
    if sudo lvs "${VG_NAME}/${LV_NAME}" &>/dev/null && [ "$fstype" = "xfs" ] && findmnt "$MOUNT_POINT" &>/dev/null; then
        pass "Logical volume ${LV_NAME} exists, XFS-formatted, and mounted at ${MOUNT_POINT}"; ((score+=4))
    else
        fail "Logical volume ${LV_NAME} missing, not XFS, or not mounted at ${MOUNT_POINT}"
    fi

    if grep -q "$MOUNT_POINT" /etc/fstab 2>/dev/null && rebooted_since_provision && findmnt "$MOUNT_POINT" &>/dev/null; then
        pass "Mount entry present in /etc/fstab and survives reboot"; ((score+=3))
    else
        fail "No /etc/fstab entry for ${MOUNT_POINT}, or persistence across reboot could not be verified — run: sudo systemctl reboot"
    fi

    if grep -Fxq "${VARIANT} volume ready" "${MOUNT_POINT}/marker.txt" 2>/dev/null; then
        pass "marker.txt contains exact expected text"; ((score+=2))
    else
        fail "marker.txt missing or does not contain '${VARIANT} volume ready'"
    fi

    local lv_size_mb initial_mb extend_mb
    lv_size_mb=$(sudo lvs -o lv_size --noheadings --units m --nosuffix "${VG_NAME}/${LV_NAME}" 2>/dev/null | tr -d ' ')
    initial_mb=$(numfmt --from=iec "${LV_INITIAL_SIZE}" 2>/dev/null | awk '{print $1/1024/1024}')
    extend_mb=$(numfmt --from=iec "${LV_EXTEND_SIZE}" 2>/dev/null | awk '{print $1/1024/1024}')
    if awk -v s="$lv_size_mb" -v i="$initial_mb" -v e="$extend_mb" 'BEGIN{exit !(s >= (i+e)*0.95)}'; then
        pass "LV size reflects the extension (${lv_size_mb}M >= ~$(awk -v i="$initial_mb" -v e="$extend_mb" 'BEGIN{print i+e}')M)"; ((score+=4))
    else
        fail "LV size (${lv_size_mb:-?}M) does not reflect initial + extend size"
    fi

    local fs_size_kb
    fs_size_kb=$(df -k --output=size "$MOUNT_POINT" 2>/dev/null | tail -1 | tr -d ' ')
    local initial_kb
    initial_kb=$(numfmt --from=iec "${LV_INITIAL_SIZE}" 2>/dev/null | awk '{print $1/1024}')
    if [ -n "$fs_size_kb" ] && awk -v f="$fs_size_kb" -v i="$initial_kb" 'BEGIN{exit !(f > i*1.3)}'; then
        pass "Filesystem size reflects the growth (not just the LV)"; ((score+=3))
    else
        fail "Filesystem at ${MOUNT_POINT} does not appear to have grown — did you run xfs_growfs?"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t3() {
    local score=0 max=15
    echo ""
    echo "Task 3 — Persistent Logging: journald + rsyslog Routing"

    local machine_id journal_dir
    machine_id=$(cat /etc/machine-id 2>/dev/null)
    journal_dir="/var/log/journal/${machine_id}"
    if [ -d "$journal_dir" ] && [ -n "$(ls -A "$journal_dir" 2>/dev/null)" ]; then
        pass "/var/log/journal/<machine-id>/ exists with rotated journal files"; ((score+=3))
    else
        fail "${journal_dir} missing or empty — is journald storage configured as persistent?"
    fi

    if rebooted_since_provision && [ -d "$journal_dir" ] && [ -n "$(ls -A "$journal_dir" 2>/dev/null)" ]; then
        pass "Persistent storage survives reboot"; ((score+=2))
    else
        fail "Cannot verify persistent journal survives reboot — run: sudo systemctl reboot"
    fi

    local rsyslog_conf
    rsyslog_conf=$(grep -rl "${RSYSLOG_FACILITY}\.${RSYSLOG_PRIORITY}" /etc/rsyslog.d/ 2>/dev/null | head -1)
    if [ -n "$rsyslog_conf" ]; then
        pass "Rsyslog config file exists under /etc/rsyslog.d/"; ((score+=2))
    else
        fail "No file under /etc/rsyslog.d/ found — create an rsyslog configuration file there"
    fi

    if [ -n "$rsyslog_conf" ] && grep -qE "${RSYSLOG_FACILITY}\.${RSYSLOG_PRIORITY}[[:space:]]+${LOG_FILE//\//\\/}" "$rsyslog_conf" 2>/dev/null; then
        pass "Config routes ${RSYSLOG_FACILITY}.${RSYSLOG_PRIORITY} to ${LOG_FILE}"; ((score+=4))
    else
        fail "Config does not route ${RSYSLOG_FACILITY}.${RSYSLOG_PRIORITY} to ${LOG_FILE}"
    fi

    local probe="grading-probe-${VARIANT}-$$"
    logger -p "${RSYSLOG_FACILITY}.${RSYSLOG_PRIORITY}" "$probe"
    sleep 2
    if sudo grep -qF "$probe" "$LOG_FILE" 2>/dev/null; then
        pass "Test message appears in ${LOG_FILE}"; ((score+=4))
    else
        fail "Test message not found in ${LOG_FILE} — is rsyslog routing active?"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t4() {
    local score=0 max=15
    echo ""
    echo "Task 4 — File Transfer: rsync Backup and Secure Upload"

    local backup_src="/home/student/${BACKUP_DIR}/exam-source"

    if [ -d "$backup_src" ]; then
        local missing=false
        for f in manifest.txt report.dat notes/log.txt; do
            [ -e "${backup_src}/${f}" ] || missing=true
        done
        if ! $missing; then
            pass "${backup_src}/ exists and contains all source files"; ((score+=2))
        else
            fail "${backup_src}/ is missing one or more expected files"
        fi
    else
        fail "${backup_src}/ does not exist"
    fi

    if [ -f "${backup_src}/manifest.txt" ] && sudo diff -q /etc/exam-source/manifest.txt "${backup_src}/manifest.txt" &>/dev/null; then
        pass "File contents match exactly"; ((score+=1))
    else
        fail "manifest.txt content does not match the original"
    fi

    local report_perms report_owner notes_perms notes_owner
    report_perms=$(stat -c '%a' "${backup_src}/report.dat" 2>/dev/null)
    report_owner=$(stat -c '%U:%G' "${backup_src}/report.dat" 2>/dev/null)
    notes_perms=$(stat -c '%a' "${backup_src}/notes/log.txt" 2>/dev/null)
    notes_owner=$(stat -c '%U:%G' "${backup_src}/notes/log.txt" 2>/dev/null)
    if [ "$report_perms" = "750" ] && [ "$report_owner" = "root:student" ] \
       && [ "$notes_perms" = "644" ] && [ "$notes_owner" = "student:student" ]; then
        pass "Permissions and ownership preserved on the distinguishing files"; ((score+=3))
    else
        fail "Permissions/ownership not preserved (report.dat: ${report_perms:-?} ${report_owner:-?}, log.txt: ${notes_perms:-?} ${notes_owner:-?})"
    fi

    echo "  [INFO] The remaining 9 points (manifest delivered to the repo VM and"
    echo "         content match) are verified by the instructor against the repo VM"
    echo "         — they cannot be checked from this machine."
    echo "  Local sub-score: ${score}/6  (full task max: ${max})"
    echo "$score $max"
}

grade_t5() {
    local score=0 max=20
    echo ""
    echo "Task 5 — NFS Client: Automount Your Shared Export"

    local autofs_active autofs_enabled
    autofs_active=$(systemctl is-active autofs 2>/dev/null)
    autofs_enabled=$(systemctl is-enabled autofs 2>/dev/null)
    if [ "$autofs_active" = "active" ] && [ "$autofs_enabled" = "enabled" ]; then
        pass "autofs is active and enabled"; ((score+=2))
    else
        fail "autofs is not active+enabled (active: ${autofs_active}, enabled: ${autofs_enabled})"
    fi

    # An indirect-map autofs setup (the standard approach here) splits
    # NFS_LOCAL_MOUNT (e.g. /remote/alpha) across two files: the master map
    # references only the base mountpoint (/remote) and an indirect map file;
    # the indirect map then supplies the final path component (alpha) as its key.
    local mount_base mount_key master_match
    mount_base=$(dirname "$NFS_LOCAL_MOUNT")
    mount_key=$(basename "$NFS_LOCAL_MOUNT")
    master_match=$(grep -rlE "^[[:space:]]*${mount_base//\//\\/}[[:space:]]" /etc/auto.master.d/*.autofs /etc/auto.master 2>/dev/null | head -1)
    if [ -n "$master_match" ]; then
        pass "Master map references ${mount_base}"; ((score+=3))
    else
        fail "No master map references ${mount_base} — check /etc/auto.master.d/ or /etc/auto.master"
    fi

    local indirect_map indirect_ok=false
    if [ -n "$master_match" ]; then
        indirect_map=$(awk -v base="$mount_base" '$1 == base {print $2; exit}' "$master_match" 2>/dev/null)
        if [ -n "$indirect_map" ] && [ -f "$indirect_map" ]; then
            local map_line
            map_line=$(awk -v key="$mount_key" '$1 == key {print; exit}' "$indirect_map" 2>/dev/null)
            if [ -n "$map_line" ] \
               && grep -q "172\.16\.16\.121:/exports/${NFS_EXPORT_DIR}" <<<"$map_line" \
               && grep -qE -- '-[a-z0-9,]*\brw\b' <<<"$map_line" \
               && grep -qE -- '-[a-z0-9,]*\bsync\b' <<<"$map_line" \
               && grep -qE 'vers=4|nfsvers=4|nfs4' <<<"$map_line"; then
                indirect_ok=true
            fi
        fi
    fi
    if $indirect_ok; then
        pass "Indirect map references the export with rw,sync,nfs4 options"; ((score+=7))
    else
        fail "Indirect map missing, or does not map '${mount_key}' to 172.16.16.121:/exports/${NFS_EXPORT_DIR} with rw,sync,nfs4 options"
    fi

    if ls "$NFS_LOCAL_MOUNT" &>/dev/null && findmnt "$NFS_LOCAL_MOUNT" &>/dev/null \
       && grep -qiF "welcome" "${NFS_LOCAL_MOUNT}/welcome.txt" 2>/dev/null; then
        pass "Mount activates and welcome.txt is readable"; ((score+=3))
    else
        fail "Mount did not activate, or welcome.txt is not readable through ${NFS_LOCAL_MOUNT}"
    fi

    echo "  [INFO] The remaining 5 points (your submitted file present on the repo VM"
    echo "         export with correct content) are verified by the instructor against"
    echo "         the repo VM — they cannot be checked from this machine."
    echo "  Local sub-score: ${score}/15  (full task max: ${max})"
    echo "$score $max"
}

grade_t6() {
    local score=0 max=15
    echo ""
    echo "Task 6 — Containers: Build, Run, and Persist a Custom Web Server"

    local containerfile="/home/student/webapp/Containerfile"
    if [ -f "$containerfile" ] \
       && grep -qE "^FROM[[:space:]]+${BASE_IMAGE//\//\\/}" "$containerfile" 2>/dev/null \
       && grep -qF "$PODMAN_IMAGE_TEXT" "$containerfile" 2>/dev/null; then
        pass "Containerfile exists, references the base image, and writes the correct text"; ((score+=4))
    else
        fail "Containerfile missing, wrong base image, or does not write the expected text"
    fi

    # NOTE: no `sudo -u student` here — `grade` already runs as the student user
    # (it's root:root 0755, self-run, not a setuid helper). Wrapping these in
    # `sudo -u student` spawns a session lacking $XDG_RUNTIME_DIR and
    # $DBUS_SESSION_BUS_ADDRESS, which breaks rootless podman discovery and
    # outright fails `systemctl --user` ("Failed to connect to user scope bus").
    if podman images --format '{{ "{{.Repository}}:{{.Tag}}" }}' 2>/dev/null | grep -q "${VARIANT}-web:1.0"; then
        pass "Image built and tagged as ${VARIANT}-web:1.0"; ((score+=2))
    else
        fail "No image tagged ${VARIANT}-web:1.0 found"
    fi

    local curl_out
    curl_out=$(curl -s "http://localhost:${PODMAN_PORT}" 2>/dev/null)
    if podman ps --format '{{ "{{.Names}} {{.Ports}}" }}' 2>/dev/null | grep -q "${VARIANT}-srv.*${PODMAN_PORT}->8080" \
       && [ "$curl_out" = "$PODMAN_IMAGE_TEXT" ]; then
        pass "Container ${VARIANT}-srv running, mapped to port ${PODMAN_PORT}, serving expected content"; ((score+=4))
    else
        fail "Container ${VARIANT}-srv not running with the expected port mapping and content"
    fi

    local unit_present=false
    if systemctl --user list-unit-files 2>/dev/null | grep -qi "${VARIANT}-srv"; then
        unit_present=true
    fi
    if $unit_present && rebooted_since_provision && [ "$curl_out" = "$PODMAN_IMAGE_TEXT" ]; then
        pass "Container survives logout/reboot via a systemd unit (verified post-reboot)"; ((score+=5))
    else
        fail "No persistent systemd unit found, or curl did not succeed after the end-of-exam reboot — run: sudo systemctl reboot"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

# ---- main ----

TASKS=()
case "${1:-all}" in
    all) TASKS=(t1 t2 t3 t4 t5 t6) ;;
    t[1-6]) TASKS=("$1") ;;
    *) echo "Usage: grade [all|t1|t2|t3|t4|t5|t6]"; exit 1 ;;
esac

echo "===== EXAM GRADING REPORT ====="
echo "Hostname: ${HOSTNAME}  Variant: ${VARIANT}"

total=0
max_total=0
task_count=$(echo "${TASKS[*]}" | wc -w)

for t in "${TASKS[@]}"; do
    result=$(run_task "$t")
    echo "$result" | head -n -1
    read -r s m <<< "$(echo "$result" | tail -1)"
    (( total += s ))
    (( max_total += m ))
done

echo ""
if [ "$task_count" -gt 1 ]; then
    echo "TOTAL: ${total}/${max_total}  (Tasks 4 and 5 include points verified only by the instructor)"
fi
echo "================================"
