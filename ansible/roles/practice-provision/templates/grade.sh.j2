#!/bin/bash
# Practice grading and reset script
# Host: {{ inventory_hostname }}
# Generated by Ansible at provisioning time. Do not edit.
#
# Usage:
#   grade [all|t1..t10]       — grade one or all tasks
#   grade reset t<N>          — reset a single task to its start state
#   grade reset all           — reset all tasks (full wipe)

HOSTNAME="{{ inventory_hostname }}"
BASE_IMAGE="{{ practice_base_image }}"

pass() { echo "  [PASS] $1"; }
fail() { echo "  [FAIL] $1"; }
info() { echo "  [INFO] $1"; }

# True if the system has been rebooted since provisioning
rebooted_since_provision() {
    [ -f /var/practice-provision-time ] || return 1
    local provision_ts boot_ts
    provision_ts=$(stat -c %Y /var/practice-provision-time)
    boot_ts=$(date -d "$(who -b | awk '{print $3, $4}')" +%s 2>/dev/null)
    [ -n "$boot_ts" ] && [ "$boot_ts" -gt "$provision_ts" ]
}

# ── Grading functions ────────────────────────────────────────────────────────

grade_t1() {
    local score=0 max=15
    echo ""
    echo "Task 1 — File and Directory Management"

    if [ -d /home/student/projects/lab-files ]; then
        pass "Directory /home/student/projects/lab-files exists"; ((score+=2))
    else
        fail "Directory /home/student/projects/lab-files missing"
    fi

    local files_ok=true
    for f in notes.txt report.txt archive.txt; do
        [ -f "/home/student/projects/lab-files/$f" ] || files_ok=false
    done
    if $files_ok; then
        pass "Files notes.txt, report.txt, archive.txt exist"; ((score+=2))
    else
        fail "One or more of notes.txt, report.txt, archive.txt missing in lab-files/"
    fi

    if diff -q /etc/hostname /home/student/projects/lab-files/hostname.txt &>/dev/null; then
        pass "hostname.txt matches /etc/hostname"; ((score+=2))
    else
        fail "hostname.txt does not match /etc/hostname"
    fi

    local report_content
    report_content=$(cat /home/student/projects/lab-files/report.txt 2>/dev/null)
    local line_count
    line_count=$(echo "$report_content" | grep -c .)
    local lines_valid=true
    while IFS= read -r line; do
        grep -qF "$line" /etc/passwd || { lines_valid=false; break; }
    done <<< "$report_content"
    if [ "${line_count:-0}" -ge 5 ] && $lines_valid; then
        pass "report.txt contains last 5 lines of /etc/passwd"; ((score+=3))
    else
        fail "report.txt does not contain last 5 lines of /etc/passwd"
    fi

    local link_count
    link_count=$(stat -c %h /home/student/projects/lab-files/report.txt 2>/dev/null)
    if [ "/home/student/projects/report-hardlink" -ef "/home/student/projects/lab-files/report.txt" ] 2>/dev/null \
       && [ "${link_count:-0}" -ge 2 ]; then
        pass "Hard link report-hardlink verified (link count = ${link_count})"; ((score+=3))
    else
        fail "Hard link /home/student/projects/report-hardlink missing or incorrect"
    fi

    if [ -L /home/student/lab-shortcut ] \
       && [ "$(readlink -f /home/student/lab-shortcut)" = "/home/student/projects/lab-files" ]; then
        pass "Symbolic link lab-shortcut verified"; ((score+=3))
    else
        fail "Symbolic link /home/student/lab-shortcut missing or points to wrong target"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t2() {
    local score=0 max=20
    echo ""
    echo "Task 2 — Users, Groups, and Password Policy"

    if getent group ops | grep -q ':50100:'; then
        pass "Group ops exists with GID 50100"; ((score+=3))
    else
        fail "Group ops missing or has wrong GID (expected 50100)"
    fi

    if id sysadmin1 &>/dev/null && id sysadmin1 | grep -q 'ops'; then
        pass "User sysadmin1 exists and is in ops group"; ((score+=2))
    else
        fail "User sysadmin1 missing or not in ops group"
    fi

    if sudo passwd -S sysadmin1 2>/dev/null | grep -qv ' LK '; then
        pass "Password is set (account not locked)"; ((score+=2))
    else
        fail "Password not set or account locked for sysadmin1"
    fi

    if sudo chage -l sysadmin1 2>/dev/null | grep -qi 'last password change.*password must be changed'; then
        pass "Force password change on first login is set"; ((score+=3))
    else
        fail "Force password change on first login is not configured"
    fi

    if sudo chage -l sysadmin1 2>/dev/null | grep -q 'Minimum.*7'; then
        pass "Minimum days between password changes: 7"; ((score+=2))
    else
        fail "Minimum days between password changes is not 7"
    fi

    if sudo chage -l sysadmin1 2>/dev/null | grep -q 'Maximum.*90'; then
        pass "Maximum days before password change required: 90"; ((score+=2))
    else
        fail "Maximum days before password change required is not 90"
    fi

    local expiry_fmt
    expiry_fmt=$(date -d "2027-06-30" "+%b %-d, %Y" 2>/dev/null)
    if sudo chage -l sysadmin1 2>/dev/null | grep -qi "account expires.*${expiry_fmt}"; then
        pass "Account expiry date: 2027-06-30"; ((score+=2))
    else
        fail "Account expiry date is not 2027-06-30"
    fi

    if sudo -l -U sysadmin1 2>/dev/null | grep -q 'NOPASSWD'; then
        pass "NOPASSWD sudo configured for sysadmin1"; ((score+=4))
    else
        fail "NOPASSWD sudo not configured for sysadmin1"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t3() {
    local score=0 max=20
    echo ""
    echo "Task 3 — File Permissions and Collaborative Directory"

    if [ -d /home/ops-workspace ]; then
        pass "Directory /home/ops-workspace exists"; ((score+=2))
    else
        fail "Directory /home/ops-workspace missing"
    fi

    local grp
    grp=$(stat -c %G /home/ops-workspace 2>/dev/null)
    if [ "$grp" = "ops" ]; then
        pass "Group owner is ops"; ((score+=3))
    else
        fail "Group owner is '${grp:-?}', expected ops"
    fi

    local perms
    perms=$(stat -c %A /home/ops-workspace 2>/dev/null)
    if echo "$perms" | grep -q '^drwx'; then
        pass "Owner has rwx"; ((score+=1))
    else
        fail "Owner does not have full rwx (permissions: ${perms:-?})"
    fi

    if echo "$perms" | cut -c5-7 | grep -qE '^rw[xsS]$'; then
        pass "Group has rwx"; ((score+=2))
    else
        fail "Group does not have rwx (permissions: ${perms:-?})"
    fi

    if echo "$perms" | cut -c8-10 | grep -qE '^--[Tt-]$'; then
        pass "Others have no access"; ((score+=2))
    else
        fail "Others have some access (permissions: ${perms:-?})"
    fi

    if echo "$perms" | cut -c7 | grep -q '[sS]'; then
        pass "SGID bit is set"; ((score+=4))
    else
        fail "SGID bit is not set (permissions: ${perms:-?})"
    fi

    if echo "$perms" | cut -c10 | grep -q '[Tt]'; then
        pass "Sticky bit is set"; ((score+=4))
    else
        fail "Sticky bit is not set (permissions: ${perms:-?})"
    fi

    if sudo grep -q 'umask 007' /home/sysadmin1/.bashrc 2>/dev/null \
       || sudo grep -q 'umask 007' /home/sysadmin1/.bash_profile 2>/dev/null; then
        pass "umask 007 found in sysadmin1's shell config"; ((score+=2))
    else
        fail "umask 007 not found in sysadmin1/.bashrc or .bash_profile"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t4() {
    local score=0 max=15
    echo ""
    echo "Task 4 — Service Management"

    local crond_active
    crond_active=$(systemctl is-active crond 2>/dev/null)
    if [ "$crond_active" = "active" ]; then
        pass "crond is active"; ((score+=2))
    else
        fail "crond is not active (state: ${crond_active})"
    fi

    local crond_enabled
    crond_enabled=$(systemctl is-enabled crond 2>/dev/null)
    if [ "$crond_enabled" = "enabled" ]; then
        pass "crond is enabled"; ((score+=3))
    else
        fail "crond is not enabled (state: ${crond_enabled})"
    fi

    local rsyslog_active
    rsyslog_active=$(systemctl is-active rsyslog 2>/dev/null)
    if [ "$rsyslog_active" = "active" ]; then
        pass "rsyslog is active"; ((score+=2))
    else
        fail "rsyslog is not active (state: ${rsyslog_active})"
    fi

    local rsyslog_enabled
    rsyslog_enabled=$(systemctl is-enabled rsyslog 2>/dev/null)
    if [ "$rsyslog_enabled" = "enabled" ]; then
        pass "rsyslog is enabled"; ((score+=3))
    else
        fail "rsyslog is not enabled (state: ${rsyslog_enabled})"
    fi

    if rebooted_since_provision; then
        if [ "$(systemctl is-active crond 2>/dev/null)" = "active" ] \
           && [ "$(systemctl is-active rsyslog 2>/dev/null)" = "active" ]; then
            pass "Service states persist across reboot (verified)"; ((score+=5))
        else
            fail "A service is not running after reboot — check crond and rsyslog"
        fi
    else
        fail "Cannot verify persistence — reboot the VM first: sudo systemctl reboot"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t5() {
    local score=0 max=15
    echo ""
    echo "Task 5 — DNF Repository and Package Management"

    if [ -f /etc/yum.repos.d/practice.repo ]; then
        pass "practice.repo file exists"; ((score+=1))
    else
        fail "/etc/yum.repos.d/practice.repo does not exist"
    fi

    if grep -q 'baseurl.*172\.16\.16\.121/repo' /etc/yum.repos.d/practice.repo 2>/dev/null; then
        pass "baseurl points to 172.16.16.121/repo"; ((score+=2))
    else
        fail "baseurl does not point to 172.16.16.121/repo"
    fi

    if grep -q 'enabled=1' /etc/yum.repos.d/practice.repo 2>/dev/null; then
        pass "enabled=1 is set"; ((score+=1))
    else
        fail "enabled=1 not found in practice.repo"
    fi

    if grep -q 'gpgcheck=0' /etc/yum.repos.d/practice.repo 2>/dev/null; then
        pass "gpgcheck=0 is set"; ((score+=2))
    else
        fail "gpgcheck=0 not found in practice.repo"
    fi

    if rpm -q vim-enhanced &>/dev/null; then
        pass "vim-enhanced is installed"; ((score+=3))
    else
        fail "vim-enhanced is not installed"
    fi

    if rpm -q wget &>/dev/null; then
        pass "wget is installed"; ((score+=3))
    else
        fail "wget is not installed"
    fi

    if ! rpm -q zip &>/dev/null; then
        pass "zip has been removed"; ((score+=3))
    else
        fail "zip is still installed — remove it: sudo dnf remove zip"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t6() {
    local score=0 max=15
    echo ""
    echo "Task 6 — Shell Scripting: Service Status Report"

    local script=/home/student/bin/service-report.sh

    if [ -x "$script" ]; then
        pass "Script ${script} exists and is executable"; ((score+=3))
    else
        fail "Script ${script} missing or not executable"
    fi

    local refs_ok=true
    for svc in sshd crond chronyd rsyslog; do
        grep -q "$svc" "$script" 2>/dev/null || refs_ok=false
    done
    if $refs_ok; then
        pass "Script references all 4 service names"; ((score+=4))
    else
        fail "Script does not reference all 4 required service names (sshd crond chronyd rsyslog)"
    fi

    local out format_ok=true
    out=$(bash "$script" 2>/dev/null)
    local line_count
    line_count=$(echo "$out" | grep -c .)
    if [ "${line_count:-0}" -eq 4 ]; then
        while IFS= read -r line; do
            [[ "$line" =~ ^SERVICE:\ [a-zA-Z0-9_.-]+\ ACTIVE:\ (active|inactive)\ ENABLED:\ (enabled|disabled)$ ]] \
                || format_ok=false
        done <<< "$out"
    else
        format_ok=false
    fi

    if $format_ok; then
        local fields_ok=true
        for svc in sshd crond chronyd rsyslog; do
            local live_active live_enabled line_active line_enabled
            live_active=$(systemctl is-active "$svc" 2>/dev/null)
            live_enabled=$(systemctl is-enabled "$svc" 2>/dev/null)
            line_active=$(echo "$out" | grep "SERVICE: ${svc} " | sed -n 's/.*ACTIVE: \([a-z]*\).*/\1/p')
            line_enabled=$(echo "$out" | grep "SERVICE: ${svc} " | sed -n 's/.*ENABLED: \([a-z]*\).*/\1/p')
            [ "$live_active" = "$line_active" ] && [ "$live_enabled" = "$line_enabled" ] || fields_ok=false
        done
        if $fields_ok; then
            pass "Script produces 4 correctly-formatted lines matching live state"; ((score+=5))
        else
            fail "Output format is correct but ACTIVE/ENABLED fields don't match live systemctl state"
        fi
    else
        fail "Output is not 4 lines in the exact required format"
    fi

    local report=/home/student/reports/service-status.txt
    bash "$script" &>/dev/null
    bash "$script" &>/dev/null
    local rerun_count
    rerun_count=$(grep -c . "$report" 2>/dev/null)
    if [ "${rerun_count:-0}" -eq 4 ]; then
        pass "Output file is overwritten on rerun (4 lines, not duplicated)"; ((score+=3))
    else
        fail "Report file ${report} has ${rerun_count:-0} lines after two runs — expected 4 (overwrite, not append)"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t7() {
    local score=0 max=20
    echo ""
    echo "Task 7 — LVM: Build, Mount, and Extend Storage"

    # OS disk and the dedicated LVM disk are both on the SCSI bus — kernel
    # assigns /dev/sd* letters in async-probe order, which can swap on reboot.
    # Identify the dedicated disk as whichever SCSI disk does NOT back root.
    local root_disk pv_disk
    root_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -1)
    pv_disk=$(sudo pvs --noheadings -o pv_name,vg_name 2>/dev/null \
              | awk '$2 == "vg_practice" {print $1}' \
              | sed -E 's#/dev/(sd[a-z]).*#\1#')
    if sudo vgs vg_practice &>/dev/null \
       && [ -n "$pv_disk" ] && [[ "$pv_disk" == sd* ]] \
       && [ "$pv_disk" != "$root_disk" ]; then
        pass "Volume group vg_practice exists on the dedicated raw disk (/dev/${pv_disk})"; ((score+=4))
    else
        fail "vg_practice missing or its PV is not on the dedicated raw SCSI disk (found: ${pv_disk:-none}, OS disk: /dev/${root_disk:-?})"
    fi

    local fstype
    fstype=$(sudo blkid -o value -s TYPE /dev/vg_practice/lv_practice 2>/dev/null)
    if sudo lvs vg_practice/lv_practice &>/dev/null \
       && [ "$fstype" = "xfs" ] \
       && findmnt /storage/practice &>/dev/null; then
        pass "lv_practice exists, XFS-formatted, and mounted at /storage/practice"; ((score+=4))
    else
        fail "lv_practice missing, not XFS, or not mounted at /storage/practice"
    fi

    if grep -q '/storage/practice' /etc/fstab 2>/dev/null \
       && rebooted_since_provision \
       && findmnt /storage/practice &>/dev/null; then
        pass "fstab entry present and mount survives reboot"; ((score+=3))
    else
        fail "No fstab entry for /storage/practice, or persistence across reboot not verified — reboot first"
    fi

    if grep -Fxq "practice volume ready" /storage/practice/marker.txt 2>/dev/null; then
        pass "marker.txt contains 'practice volume ready'"; ((score+=2))
    else
        fail "marker.txt missing or does not contain 'practice volume ready'"
    fi

    local lv_size_mb initial_mb extend_mb
    lv_size_mb=$(sudo lvs -o lv_size --noheadings --units m --nosuffix vg_practice/lv_practice 2>/dev/null | tr -d ' ')
    initial_mb=300
    extend_mb=500
    if awk -v s="$lv_size_mb" -v i="$initial_mb" -v e="$extend_mb" \
        'BEGIN{exit !(s >= (i+e)*0.95)}'; then
        pass "LV size reflects the extension (${lv_size_mb}M >= ~$((initial_mb+extend_mb))M)"; ((score+=4))
    else
        fail "LV size (${lv_size_mb:-?}M) does not reflect 300M initial + 500M extension"
    fi

    local fs_size_kb
    fs_size_kb=$(df -k --output=size /storage/practice 2>/dev/null | tail -1 | tr -d ' ')
    if [ -n "$fs_size_kb" ] && awk -v f="$fs_size_kb" 'BEGIN{exit !(f > 300*1024*1.3)}'; then
        pass "Filesystem size reflects the growth (not just the LV)"; ((score+=3))
    else
        fail "Filesystem at /storage/practice does not appear to have grown — did you run xfs_growfs?"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t8() {
    local score=0 max=15
    echo ""
    echo "Task 8 — Persistent Logging: journald + rsyslog"

    local machine_id journal_dir
    machine_id=$(cat /etc/machine-id 2>/dev/null)
    journal_dir="/var/log/journal/${machine_id}"
    if [ -d "$journal_dir" ] && [ -n "$(ls -A "$journal_dir" 2>/dev/null)" ]; then
        pass "/var/log/journal/<machine-id>/ exists with journal files"; ((score+=3))
    else
        fail "${journal_dir} missing or empty — is journald storage set to persistent?"
    fi

    if rebooted_since_provision && [ -d "$journal_dir" ] && [ -n "$(ls -A "$journal_dir" 2>/dev/null)" ]; then
        pass "Persistent storage verified after reboot"; ((score+=2))
    else
        fail "Cannot verify persistent journal survives reboot — reboot first: sudo systemctl reboot"
    fi

    local rsyslog_conf
    rsyslog_conf=$(grep -rl 'local3\.warning' /etc/rsyslog.d/ 2>/dev/null | head -1)
    if [ -n "$rsyslog_conf" ]; then
        pass "Rsyslog config file exists under /etc/rsyslog.d/"; ((score+=2))
    else
        fail "No file under /etc/rsyslog.d/ routes local3.warning — create one"
    fi

    if [ -n "$rsyslog_conf" ] \
       && grep -qE 'local3\.warning[[:space:]]+/var/log/practice-events' "$rsyslog_conf" 2>/dev/null; then
        pass "Config routes local3.warning to /var/log/practice-events"; ((score+=4))
    else
        fail "Config does not route local3.warning to /var/log/practice-events"
    fi

    local probe="practice-probe-$$"
    logger -p local3.warning "$probe"
    sleep 2
    if sudo grep -qF "$probe" /var/log/practice-events 2>/dev/null; then
        pass "Test message appears in /var/log/practice-events"; ((score+=4))
    else
        fail "Test message not found in /var/log/practice-events — is rsyslog routing active?"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t9() {
    local score=0 max=15
    echo ""
    echo "Task 9 — SELinux: File Context and Boolean"

    # Check 1: SELinux is enforcing
    local selinux_mode
    selinux_mode=$(getenforce 2>/dev/null)
    if [ "$selinux_mode" = "Enforcing" ]; then
        pass "SELinux is in Enforcing mode"; ((score+=3))
    else
        fail "SELinux is not Enforcing (current: ${selinux_mode:-?})"
    fi

    # Check 2: /var/www/html/practice.html has the correct httpd_sys_content_t context
    local file_ctx
    file_ctx=$(ls -Z /var/www/html/practice.html 2>/dev/null | awk '{print $1}' | sed 's/.*:\([^:]*\):.*/\1/')
    if [ "$file_ctx" = "httpd_sys_content_t" ]; then
        pass "practice.html has correct SELinux type: httpd_sys_content_t"; ((score+=5))
    else
        fail "practice.html has wrong SELinux type: ${file_ctx:-?} (expected httpd_sys_content_t)"
    fi

    # Check 3: The context fix is persistent (restorecon-safe — in fcontext policy)
    local policy_ctx
    policy_ctx=$(semanage fcontext -l 2>/dev/null | grep '/var/www/html/practice\.html' | awk '{print $NF}')
    if echo "$policy_ctx" | grep -q 'httpd_sys_content_t'; then
        pass "Context fix is recorded in SELinux policy (survives restorecon)"; ((score+=3))
    else
        info "Context fix not found in semanage fcontext — used chcon only (not persistent)"
        fail "Use 'semanage fcontext' + 'restorecon' to make the fix persistent"
    fi

    # Check 4: httpd_can_network_connect_db SELinux boolean is on
    local bool_val
    bool_val=$(getsebool httpd_can_network_connect_db 2>/dev/null | awk '{print $NF}')
    if [ "$bool_val" = "on" ]; then
        pass "httpd_can_network_connect_db boolean is on"; ((score+=4))
    else
        fail "httpd_can_network_connect_db boolean is off — enable it persistently with setsebool -P"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

grade_t10() {
    local score=0 max=15
    echo ""
    echo "Task 10 — Podman: Build, Run, and Persist a Container"

    local containerfile=/home/student/webapp/Containerfile
    if [ -f "$containerfile" ] \
       && grep -qE "^FROM[[:space:]]+${BASE_IMAGE//\//\\/}" "$containerfile" 2>/dev/null \
       && grep -qF "Practice web server" "$containerfile" 2>/dev/null; then
        pass "Containerfile exists, references base image, writes expected text"; ((score+=4))
    else
        fail "Containerfile missing, wrong base image, or missing 'Practice web server' text"
    fi

    if podman images --format '{{ "{{.Repository}}:{{.Tag}}" }}' 2>/dev/null \
       | grep -q 'practice-web:1.0'; then
        pass "Image built and tagged as practice-web:1.0"; ((score+=2))
    else
        fail "No image tagged practice-web:1.0 found"
    fi

    local curl_out
    curl_out=$(curl -s http://localhost:8180 2>/dev/null)
    if podman ps --format '{{ "{{.Names}} {{.Ports}}" }}' 2>/dev/null \
       | grep -q 'practice-srv.*8180->8080' \
       && [ "$curl_out" = "Practice web server" ]; then
        pass "Container practice-srv running on port 8180, serving expected content"; ((score+=4))
    else
        fail "Container practice-srv not running on port 8180 with expected content"
    fi

    local unit_present=false
    if systemctl --user list-unit-files 2>/dev/null | grep -qi 'practice-srv'; then
        unit_present=true
    fi
    if $unit_present && rebooted_since_provision && [ "$curl_out" = "Practice web server" ]; then
        pass "Container persists via systemd unit (verified post-reboot)"; ((score+=5))
    else
        fail "No persistent systemd unit found, or content not served after reboot — reboot and re-run grade"
    fi

    echo "  Score: ${score}/${max}"
    echo "$score $max"
}

# ── Reset functions ──────────────────────────────────────────────────────────
# Each reset undoes exactly what that task's student work creates,
# then restores the provisioned start state for that task.

reset_t1() {
    echo "Resetting Task 1 — File and Directory Management..."
    sudo rm -rf /home/student/projects/lab-files
    sudo rm -f /home/student/projects/report-hardlink
    sudo rm -f /home/student/lab-shortcut
    echo "  Done. Re-attempt Task 1 from scratch."
}

reset_t2() {
    echo "Resetting Task 2 — Users, Groups, and Password Policy..."
    sudo userdel -r sysadmin1 2>/dev/null || true
    sudo rm -f /etc/sudoers.d/sysadmin1
    echo "  Done. User sysadmin1 removed. ops group retained (needed by T3)."
}

reset_t3() {
    echo "Resetting Task 3 — File Permissions and Collaborative Directory..."
    sudo rm -rf /home/ops-workspace
    echo "  Done. Re-attempt Task 3 from scratch."
}

reset_t4() {
    echo "Resetting Task 4 — Service Management..."
    sudo systemctl stop crond rsyslog 2>/dev/null || true
    sudo systemctl disable crond rsyslog 2>/dev/null || true
    echo "  Done. crond and rsyslog are stopped and disabled again."
}

reset_t5() {
    echo "Resetting Task 5 — DNF Repository and Package Management..."
    sudo rm -f /etc/yum.repos.d/practice.repo
    sudo dnf remove -y vim-enhanced wget 2>/dev/null || true
    sudo dnf install -y zip 2>/dev/null || true
    echo "  Done. Repo file removed, packages restored to start state."
}

reset_t6() {
    echo "Resetting Task 6 — Shell Scripting..."
    rm -f /home/student/bin/service-report.sh
    rm -f /home/student/reports/service-status.txt
    # Restore the T6 service mix (sshd: active+enabled, crond: active+disabled,
    # chronyd: inactive+enabled, rsyslog: inactive+disabled)
    sudo systemctl start crond 2>/dev/null || true
    sudo systemctl disable crond 2>/dev/null || true
    sudo systemctl stop chronyd 2>/dev/null || true
    sudo systemctl enable chronyd 2>/dev/null || true
    sudo systemctl stop rsyslog 2>/dev/null || true
    sudo systemctl disable rsyslog 2>/dev/null || true
    echo "  Done. Script and report removed; service mix restored."
}

reset_t7() {
    echo "Resetting Task 7 — LVM..."
    sudo umount /storage/practice 2>/dev/null || true
    sudo sed -i '/\/storage\/practice/d' /etc/fstab
    sudo systemctl daemon-reload 2>/dev/null || true
    sudo rm -rf /storage/practice
    sudo lvremove -fy vg_practice/lv_practice 2>/dev/null || true
    sudo vgremove -fy vg_practice 2>/dev/null || true
    # Remove PV and wipe signatures — disk letter may vary, identify by non-root SCSI disk
    local root_disk
    root_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -1)
    local raw_disk
    raw_disk=$(lsblk -ndo NAME,TYPE | awk '$2=="disk" {print $1}' \
               | grep -v "^${root_disk}$" | head -1)
    if [ -n "$raw_disk" ]; then
        sudo pvremove -ffy "/dev/${raw_disk}1" 2>/dev/null || true
        sudo parted -s "/dev/${raw_disk}" rm 1 2>/dev/null || true
        sudo wipefs -a "/dev/${raw_disk}" 2>/dev/null || true
    fi
    # Refresh provision timestamp so reboot checks work on next attempt
    sudo touch /var/practice-provision-time
    echo "  Done. LVM stack removed; /dev/${raw_disk:-sdb} wiped back to raw."
}

reset_t8() {
    echo "Resetting Task 8 — Persistent Logging..."
    sudo rm -rf /var/log/journal
    sudo find /etc/rsyslog.d/ -name '*.conf' \
         ! -name '*.rpmsave' \
         -newer /var/practice-provision-time \
         -delete 2>/dev/null || true
    sudo rm -f /var/log/practice-events
    sudo systemctl restart systemd-journald 2>/dev/null || true
    sudo systemctl restart rsyslog 2>/dev/null || true
    sudo touch /var/practice-provision-time
    echo "  Done. Journal directory and rsyslog routing removed."
}

reset_t9() {
    echo "Resetting Task 9 — SELinux..."
    # Re-apply the wrong context that was provisioned
    sudo chcon -t var_t /var/www/html/practice.html 2>/dev/null || true
    # Remove any semanage fcontext the student added for this file
    sudo semanage fcontext -d /var/www/html/practice.html 2>/dev/null || true
    # Turn the boolean back off
    sudo setsebool -P httpd_can_network_connect_db off 2>/dev/null || true
    echo "  Done. practice.html has wrong context again; boolean is off."
}

reset_t10() {
    echo "Resetting Task 10 — Podman..."
    podman stop practice-srv 2>/dev/null || true
    podman rm practice-srv 2>/dev/null || true
    podman rmi practice-web:1.0 2>/dev/null || true
    systemctl --user disable --now container-practice-srv.service 2>/dev/null || true
    rm -f ~/.config/systemd/user/container-practice-srv.service
    systemctl --user daemon-reload 2>/dev/null || true
    rm -rf /home/student/webapp
    echo "  Done. Container, image, webapp dir, and systemd unit removed."
}

reset_all() {
    echo "Resetting all tasks..."
    reset_t1; reset_t2; reset_t3; reset_t4; reset_t5
    reset_t6; reset_t7; reset_t8; reset_t9; reset_t10
    echo ""
    echo "All tasks reset. Re-read practice-tasks.txt to start fresh."
}

run_grade() {
    local task="$1"
    case "$task" in
        t1)  grade_t1 ;;
        t2)  grade_t2 ;;
        t3)  grade_t3 ;;
        t4)  grade_t4 ;;
        t5)  grade_t5 ;;
        t6)  grade_t6 ;;
        t7)  grade_t7 ;;
        t8)  grade_t8 ;;
        t9)  grade_t9 ;;
        t10) grade_t10 ;;
        *) echo "Unknown task: $task"; exit 1 ;;
    esac
}

run_reset() {
    local task="$1"
    case "$task" in
        t1)  reset_t1 ;;
        t2)  reset_t2 ;;
        t3)  reset_t3 ;;
        t4)  reset_t4 ;;
        t5)  reset_t5 ;;
        t6)  reset_t6 ;;
        t7)  reset_t7 ;;
        t8)  reset_t8 ;;
        t9)  reset_t9 ;;
        t10) reset_t10 ;;
        all) reset_all ;;
        *) echo "Unknown task: $task"; exit 1 ;;
    esac
}

# ── Main ────────────────────────────────────────────────────────────────────

if [ "${1:-}" = "reset" ]; then
    shift
    if [ -z "${1:-}" ]; then
        echo "Usage: grade reset <t1..t10|all>"
        exit 1
    fi
    run_reset "$1"
    exit 0
fi

TASKS=()
case "${1:-all}" in
    all) TASKS=(t1 t2 t3 t4 t5 t6 t7 t8 t9 t10) ;;
    t[1-9]|t10) TASKS=("$1") ;;
    *) echo "Usage: grade [all|t1..t10]  OR  grade reset [t1..t10|all]"; exit 1 ;;
esac

echo "===== PRACTICE GRADING REPORT ====="
echo "Host: ${HOSTNAME}"
echo ""

total=0
max_total=0
task_count="${#TASKS[@]}"

for t in "${TASKS[@]}"; do
    result=$(run_grade "$t")
    echo "$result" | head -n -1
    read -r s m <<< "$(echo "$result" | tail -1)"
    (( total += s ))
    (( max_total += m ))
done

echo ""
if [ "$task_count" -gt 1 ]; then
    echo "TOTAL: ${total}/${max_total}"
fi
echo "===================================="
echo ""
echo "To retry a task: grade reset t<N>   (e.g. grade reset t3)"
echo "To retry all:    grade reset all"
